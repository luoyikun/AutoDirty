<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>AutoDirty</PackageId>
    <Description>Unity-compatible Roslyn source generator that creates dirty-marking properties.</Description>
    <Authors>AutoDirty</Authors>
    <NoWarn>$(NoWarn);RS1036;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <Target Name="CopyToUnityRoslynAnalyzers" AfterTargets="Build">
    <PropertyGroup>
      <UnityRoslynDir>$(ProjectDir)..\AutoDirtyUnity\Assets\Roslyn\</UnityRoslynDir>
    </PropertyGroup>
    <MakeDir Directories="$(UnityRoslynDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityRoslynDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
